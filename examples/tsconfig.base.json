{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@gpui-native/vue": ["../packages/vue/src/index.ts"],
      "gpui-vue/*": ["../packages/vue/src/*.ts"]
    },
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@gpui-native/vue",
    "types": ["node"]
  },
  "vueCompilerOptions": {
    "lib": "@gpui-native/vue",
    "strictTemplates": true
  }
}
