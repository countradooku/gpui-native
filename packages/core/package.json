{
  "name": "@gpui-native/core",
  "version": "0.1.0",
  "description": "Framework-neutral N-API bindings for GPUI Native",
  "homepage": "https://github.com/countradooku/gpui-native#readme",
  "bugs": {
    "url": "https://github.com/countradooku/gpui-native/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/countradooku/gpui-native.git",
    "directory": "packages/core"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "*.node"
  ],
  "main": "index.cjs",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/gpui-core/Cargo.toml --no-default-features --features napi-bindings,native-window,test-support --output-dir .",
    "build:release": "napi build --platform --release --manifest-path ../../crates/gpui-core/Cargo.toml --no-default-features --features napi-bindings,native-window --output-dir .",
    "build:headless": "bun run build"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.1.3"
  },
  "napi": {
    "binaryName": "gpui-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
