{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "vitest", "import", "promise", "node"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vue/prefer-import-from-vue": "off"
  },
  "env": {
    "builtin": true,
    "node": true,
    "vitest": true,
    "vue": true
  }
}
